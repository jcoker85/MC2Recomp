# Disc images and anything taken from the game never go into this repository.
*.iso
*.chd
*.cue
*.bin
*.img
*.cso
*.elf
*.zip
*.7z
# The game's program as it is on the disc (SLUS_202.09) and any copy of it
SLUS_*

# Memory cards, save states, recordings and memory dumps of a running game
*.ps2
*.mcd
*.state
*.sstate
*.inputs
*.dmp

# Cover art for the launcher, downloaded at run time from libretro-thumbnails; not ours to redistribute
/covers/
# Screenshots of the game
/screenshots/

# Build outputs
/MC2Recomp.exe
/games.txt
/hub/build/
/dist/
*.log

# Written by the launcher at run time
/settings.ini
/mc2-options/boot.txt

# Local working files (old toolkit copies, backups, downloads, tools)
/_local/
/backup-*/
/ps2-native-recomp-0.0.2/
/tools/releases/
/tools/mame/

# Editor / OS
/.idea/
/.vs/
/.vscode/
/.claude/
*.swp
Thumbs.db
.DS_Store
__pycache__/

# The launcher icon (Midnight Club II icon by RAZELIGHT, SteamGridDB): downloaded by tools/make_icon.ps1, not ours to redistribute
/hub/icon/
